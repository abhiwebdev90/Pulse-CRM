NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used for the demo-login seeding and Stripe webhook. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo account (created by `npm run seed`)
DEMO_EMAIL=demo@pulsecrm.dev
DEMO_PASSWORD=change-me-demo-password

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Supabase project (server-only)
SUPABASE_PROJECT_NAME=
SUPABASE_DB_PASSWORD=
